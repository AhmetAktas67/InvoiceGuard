@Metadata.layer: #CUSTOMER
@UI.headerInfo: { typeName: 'Item',
                  typeNamePlural: 'Items',
                  title: { type: #STANDARD, value: 'ItemNo' } }
annotate entity ZC_IG_InvoiceItem with
{
  @UI.facet: [
    { id: 'Item', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Item', position: 10 } ]

  @UI.hidden: true
  ItemUuid;

  @UI.hidden: true
  InvoiceUuid;

  @EndUserText.label: 'Item'
  @UI: { lineItem: [{ position: 10 }], identification: [{ position: 10 }] }
  ItemNo;

  @EndUserText.label: 'Purchase Order'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_IG_PurchaseOrderItem', element: 'PoId' },
                                       additionalBinding: [{ localElement: 'PoItem', element: 'PoItem', usage:  #RESULT }] }]
  @UI: { lineItem: [{ position: 20 }], identification: [{ position: 20 }] }
  PoId;

  @EndUserText.label: 'PO Item'
  @UI: { lineItem: [{ position: 30 }], identification: [{ position: 30 }] }
  PoItem;

  @EndUserText.label: 'Quantity'
  @UI: { lineItem: [{ position: 40 }], identification: [{ position: 40 }] }
  Quantity;

  @EndUserText.label: 'Unit'
   @Consumption.valueHelpDefinition: [{ entity: { name: 'I_UnitOfMeasureStdVH', element: 'UnitOfMeasure' } }]
  Unit;

  @EndUserText.label: 'Net Price'
  @UI: { lineItem: [{ position: 50 }], identification: [{ position: 50 }] }
  NetPrice;

  @EndUserText.label: 'Currency'
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CurrencyStdVH', element: 'Currency' } }]
  Currency;

  @EndUserText.label: 'Check Result'
  @UI: { lineItem: [{ position: 60 }] }
  CheckStatus;

  @UI.hidden: true
  LocalLastChangedAt;
}