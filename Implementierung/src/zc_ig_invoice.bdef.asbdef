projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_IG_Invoice alias Invoice
{
  use create;
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;
  use action checkInvoice;

  use association _Item { create; with draft; }
}

define behavior for ZC_IG_InvoiceItem alias Item
{
  use update;
  use delete;


  use association _Invoice { with draft; }
}